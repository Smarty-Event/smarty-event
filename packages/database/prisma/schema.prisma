datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  EVENT_MANAGER
  FINANCE
  CHECK_IN_STAFF
  ATTENDEE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum TicketStatus {
  CREATED
  SOLD
  ISSUED
  ACTIVE
  CHECKED_IN
  COMPLETED
  RESOLD
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

model Tenant {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  logo             String?
  customDomain     String?     @unique
  stellarPublicKey String?     // The Tenant's Stellar wallet public key
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  users            User[]
  events           Event[]
  attendees        Attendee[]
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role          @default(ATTENDEE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attendee     Attendee?
  checkIns     CheckIn[]     @relation("ScannedByUser")
  notifications Notification[]

  @@index([tenantId])
}

model Event {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  banner        String?
  category      String?
  status        EventStatus    @default(DRAFT)
  startDate     DateTime
  endDate       DateTime
  venue         Json?          // { name: string, address: string, coordinates: { lat: number, lng: number } }
  capacity      Int
  timezone      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  speakers      Speaker[]
  sessions      Session[]
  ticketTypes   TicketType[]
  discountCodes DiscountCode[]

  @@index([tenantId])
}

model Speaker {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  bio       String?
  avatar    String?
  social    Json?     // { twitter: string, linkedin: string, website: string }
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]

  @@index([eventId])
}

model Session {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speakerId   String?
  speaker     Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  roomId      String?
  trackId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@index([speakerId])
}

model TicketType {
  id             String    @id @default(uuid())
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String    // VIP, General Admission, Early Bird, etc.
  price          Int       // Price in minor units (e.g. 50000 cents = 500.00 NGN/USDC)
  currency       String    // USDC, NGN, USD, etc.
  quantity       Int       // Total capacity of this ticket type
  sold           Int       @default(0)
  benefits       Json?     // string[] array of benefits
  earlyBirdPrice Int?
  earlyBirdUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tickets        Ticket[]

  @@index([eventId])
}

model Attendee {
  id               String   @id @default(uuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email            String
  name             String
  stellarPublicKey String?  // The Attendee's Stellar wallet public key
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tickets          Ticket[]

  @@index([tenantId])
}

model Ticket {
  id               String       @id @default(uuid())
  ticketTypeId     String
  ticketType       TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  attendeeId       String
  attendee         Attendee     @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  stellarAssetCode String?      // Asset code representing the ticket on Stellar network (e.g., EVT26VIP)
  stellarTxHash    String?      // Tx hash of minting/transfer
  qrToken          String?      // HMAC-SHA256 signature token for offline/secure verification
  status           TicketStatus @default(CREATED)
  issuedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  checkIns         CheckIn[]
  payments         Payment[]

  @@index([ticketTypeId])
  @@index([attendeeId])
}

model CheckIn {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  scannedAt   DateTime @default(now())
  scannedById String
  scannedBy   User     @relation("ScannedByUser", fields: [scannedById], references: [id])
  deviceId    String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([scannedById])
}

model Payment {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String
  method        String        // USDC, CARD, BANK_TRANSFER
  status        PaymentStatus @default(PENDING)
  stellarTxHash String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ticketId])
}

model DiscountCode {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code        String   // e.g. EARLY50
  discountPct Int      // e.g. 50 for 50%
  maxUses     Int
  used        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  type      String              // TICKET_PURCHASED, EVENT_REMINDER, etc.
  payload   Json                // Custom notification metadata
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
}
